# local data - never pushed (large scanned PDFs, generated output)
/pdf/
/processed_pdf/
/segmented_form/

# python virtual environment - recreate from segmentation/requirements.txt
segmentation/.venv/

# generated by stage1_discover.py / discover.py - regenerate locally, not tracked
segmentation/program/discovery/

# discovery_full/: keep the review montages and label csvs in git (so labels.csv
# tagging work survives), but not the big binary page_clusters.pkl - that's
# regenerated locally by stage1_discover.py.
segmentation/program/discovery_full/*
!segmentation/program/discovery_full/clusters/
!segmentation/program/discovery_full/clusters/*.png
!segmentation/program/discovery_full/*.csv

__pycache__/
*.pyc

